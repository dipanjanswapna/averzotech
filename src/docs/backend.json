

{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents a product in the e-commerce store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "pricing": {
          "type": "object",
          "properties": {
            "price": { "type": "number" },
            "comparePrice": { "type": "number" },
            "wholesalePrice": { "type": "number" },
            "discount": { "type": "number" }
          }
        },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "organization": {
            "type": "object",
            "properties": {
                "category": { "type": "string" },
                "group": { "type": "string" },
                "subcategory": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } },
                "status": { "type": "string" }
            }
        },
        "inventory": {
            "type": "object",
            "properties": {
                 "stock": { "type": "number" },
                 "initialStock": { "type": "number" },
                 "sku": { "type": "string" },
                 "availability": { "type": "string", "enum": ["in-stock", "out-of-stock", "pre-order"] },
                 "moq": { "type": "number" },
                 "maxPurchaseLimit": { "type": "number" }
            }
        },
        "brand": { "type": "string" },
        "variants": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "sku": { "type": "string" },
                    "wholesalePrice": { "type": "number" },
                    "stock": { "type": "number" },
                    "color": { "type": "string" },
                    "size": { "type": "string" },
                    "tiers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "minQuantity": { "type": "number" },
                                "pricePerUnit": { "type": "number" }
                            }
                        }
                    },
                    "batches": {
                      "type": "array",
                      "items": {
                          "type": "object",
                          "properties": {
                              "batchNumber": { "type": "string" },
                              "expiryDate": { "type": "string", "format": "date" },
                              "stock": { "type": "number" }
                          }
                      }
                    }
                }
            }
        }
      },
      "required": ["name", "pricing", "images", "organization", "inventory"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a customer's order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/OrderItem" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Shipped", "Fulfilled", "Cancelled"] },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "OrderItem": {
      "title": "Order Item",
      "description": "Represents an item within an order.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "sku": { "type": "string" }
      },
      "required": ["productId", "name", "quantity", "price"]
    },
    "User": {
        "title": "User",
        "description": "Represents a user account.",
        "type": "object",
        "properties": {
            "fullName": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "role": { "type": "string", "enum": ["customer", "vendor", "admin", "delivery"] },
            "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["fullName", "email", "role", "status"]
    },
    "ReturnItem": {
      "title": "Return Item",
      "description": "Represents an item within a return request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "comment": { "type": "string" },
        "photoUrl": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name", "image", "quantity", "reason"]
    },
    "ReturnRequest": {
      "title": "Return Request",
      "description": "Represents a customer's request to return items from an order.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/ReturnItem" } },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Processing", "Completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "items", "status"]
    },
    "VendorInvoiceItem": {
      "title": "Vendor Invoice Item",
      "description": "Represents a product item within a vendor's invoice to Averzo.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["productId", "productName", "quantity", "price", "total"]
    },
    "VendorInvoice": {
      "title": "Vendor Invoice",
      "description": "Represents an invoice from a vendor to Averzo for stock supply.",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/VendorInvoiceItem" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Processing", "Paid", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorId", "vendorName", "items", "total", "status"]
    },
     "PurchaseOrderItem": {
      "title": "Purchase Order Item",
      "description": "Represents an item within a purchase order.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["productId", "productName", "quantity", "price", "total", "sku"]
    },
     "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Represents a purchase order from Averzo to a vendor.",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/PurchaseOrderItem" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Shipped", "Received", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "estimatedDelivery": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "required": ["vendorId", "vendorName", "items", "total", "status"]
    },
    "VendorApplication": {
      "title": "Vendor Application",
      "description": "Represents a vendor's application to join the platform.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Update Requested"] }
      },
      "required": ["userId", "status"]
    }
  },
  "auth": {
    "providers": ["Email", "Google"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores individual product details."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile information."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores customer order information."
    },
    "/returns/{returnId}": {
      "schema": { "$ref": "#/entities/ReturnRequest" },
      "description": "Stores customer return requests."
    },
    "/vendorInvoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/VendorInvoice" },
      "description": "Stores invoices from vendors for stock supply."
    },
     "/purchaseOrders/{purchaseOrderId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Stores purchase orders sent to vendors."
    },
    "/vendorApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/VendorApplication" },
      "description": "Stores applications from potential vendors."
    }
  }
}
