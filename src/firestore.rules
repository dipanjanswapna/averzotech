
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'admin';
    }
    
    function isVendor() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'vendor';
    }

    function isCustomer() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'customer';
    }

    // USERS collection
    match /users/{userId} {
      // Admins can read/write any user document
      // Users can read/write their own document
      allow read, update: if isAdmin() || isOwner(userId);
      // Admins can create/delete users
      allow create, delete: if isAdmin();

      // ADDRESSES subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // PRODUCTS collection
    match /products/{productId} {
      // Anyone can read active products
      allow get: if resource.data.organization.status == 'active';
      allow list: if true; // Allow listing for queries, further checks on client

      // Admins can create/update/delete any product
      allow create, update, delete: if isAdmin();
      
      // Vendors can create products
      allow create: if isVendor() && request.resource.data.vendor == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName;
      
      // Vendors can update/delete their own products
      allow update, delete: if isVendor() && resource.data.vendor == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName;

       // REVIEWS subcollection
      match /reviews/{reviewId} {
        allow read, list: if true;
        // Logged-in users can create reviews (client-side logic should check for purchase)
        allow create: if isSignedIn();
      }

      // QNA subcollection
      match /qna/{qnaId} {
        allow read, list: if true;
         // Logged-in users can ask questions
        allow create: if isSignedIn();
        // Admins can answer questions (update)
        allow update: if isAdmin();
      }
    }
    
    // ORDERS collection
    match /orders/{orderId} {
      // Admins can read/update any order
      allow read, update: if isAdmin() || isOwner(resource.data.userId);
      // Customers can read their own orders
      allow get: if isOwner(resource.data.userId);
      // Customers can create orders, Admins can delete
      allow create: if isCustomer();
      allow delete: if isAdmin();

      // NOTES subcollection
      match /notes/{noteId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
      }
    }

    // PURCHASE_ORDERS collection
    match /purchaseOrders/{purchaseOrderId} {
      // Admins can manage all POs
      allow read, write: if isAdmin();
      // Vendors can read and update their own POs
      allow read, update: if isVendor() && resource.data.vendorId == request.auth.uid;
    }

    // RETURNS collection
    match /returns/{returnId} {
      // Admins can manage all return requests
      allow read, update: if isAdmin();
      // Users can create and read their own return requests
      allow create, read: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);

       // NOTES subcollection for returns
      match /notes/{noteId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/returns/$(returnId)).data.userId);
      }
    }

    // COUPONS collection
    match /coupons/{couponId} {
      // Admins can manage coupons
      allow read, write, delete, create: if isAdmin();
      // Customers can read coupon details
      allow get, list: if isCustomer();
    }
    
    // CAMPAIGNS collection
    match /campaigns/{campaignId} {
        // Anyone can read active campaigns
        allow get, list: if true;
        // Admins can manage campaigns
        allow create, update, delete: if isAdmin();
    }
    
    // SITE_CONTENT collection
    match /site_content/{docId} {
        // Public can read site content
        allow get, list: if true;
        // Admins can update site content
        allow write: if isAdmin();
    }

    // PENDING_ORDERS collection (temporary orders before payment confirmation)
    match /pending_orders/{orderId} {
      // Server-side logic handles this, restrict client access
      allow read, write: if false;
    }
    
    // BKASH_TOKENS collection
    match /bkash_tokens/{tokenId} {
        // Only backend can access this
        allow read, write: if false;
    }
    
    // VENDOR_INVOICES collection
    match /vendorInvoices/{invoiceId} {
        allow read, update: if isAdmin();
        allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
        allow get: if isVendor() && resource.data.vendorId == request.auth.uid;
        allow list: if isVendor() && resource.data.vendorId == request.auth.uid;
    }

    // VENDOR_APPLICATIONS collection
    match /vendorApplications/{applicationId} {
      // Logged-in users can create their own application
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admins can read and update applications
      allow read, update: if isAdmin();
    }

     // VENDORS collection
    match /vendors/{vendorId} {
      // Admins can manage vendor profiles
      allow read, write: if isAdmin();
      // Vendors can read their own profile
      allow get: if isVendor() && isOwner(get(/databases/$(database)/documents/vendors/$(vendorId)).data.userId);
    }
  }
}
